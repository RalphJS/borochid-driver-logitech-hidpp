# Access to Logitech HID++ 2.0 mice for the active local session user.
#
# Devices paired to a receiver get their own HID device from hid-logitech-dj
# ("0003:046D:<wireless PID>.NNNN"), and KERNELS matches that exact product.
# Never grant the receiver itself: its node carries the traffic of every
# device paired to it, keyboards included, and raw access to a keyboard lets
# any process in the session read keystrokes. Never vendor-wide either.
# uaccess (not MODE="0666") keeps other users and system services out. The
# file must sort before 73-seat-late.rules.

# G502 X LIGHTSPEED through its receiver
SUBSYSTEM=="hidraw", KERNELS=="0003:046D:409F.*", TAG+="uaccess"
